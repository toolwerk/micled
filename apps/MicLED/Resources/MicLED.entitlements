<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keine Sandbox: USB-HID-Zugriff und Webhook brauchen sonst Sonderrechte.
	     Hardened Runtime ist über ENABLE_HARDENED_RUNTIME in project.yml aktiv. -->
	<!-- Kalender für die Termin-Vorwarnung (unter Hardened Runtime Pflicht) -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
