    "Einmal am Tag. Vor der Installation fragt MicLED nach.\nInstalliert: MicLED %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal am Tag. Vor der Installation fragt MicLED nach.\nInstalliert: MicLED %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once a day. MicLED asks before installing.\nInstalled: MicLED %@"
          }
        }
      }
    },
    "Einschaltknopf 5–7 Sekunden halten, bis die Lichter blinken, dann „Koppeln“. Danach hat die Lampe wieder An/Aus, Helligkeit und Farbe bzw. Effekt von vorher. Der Schlüssel liegt im Schlüsselbund.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschaltknopf 5–7 Sekunden halten, bis die Lichter blinken, dann „Koppeln“. Danach hat die Lampe wieder An/Aus, Helligkeit und Farbe bzw. Effekt von vorher. Der Schlüssel liegt im Schlüsselbund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the power button for 5–7 seconds until the lights flash, then “Pair”. Afterwards the light gets back its on/off, brightness and color or effect from before. The key is stored in the keychain."
          }
        }
      }
    },
