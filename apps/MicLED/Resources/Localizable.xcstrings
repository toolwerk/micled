    "Bei jedem Wechsel geht ein POST mit {\"on_air\": true, \"camera\": false, \"apps\": […]} an diese Adresse, z. B. an einen Home-Assistant-Webhook für ein Türschild. Leer = aus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei jedem Wechsel geht ein POST mit {\"on_air\": true, \"camera\": false, \"apps\": […]} an diese Adresse, z. B. an einen Home-Assistant-Webhook für ein Türschild. Leer = aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On every change, a POST with {\"on_air\": true, \"camera\": false, \"apps\": […]} goes to this address, e.g. a Home Assistant webhook for a door sign. Empty = off."
          }
        }
      }
    },
